{
  "name": "htmlpdfx",
  "version": "0.1.0",
  "description": "Modern HTML-to-PDF for JavaScript & TypeScript. One unified API across Node, Bun, and the browser. Uses a real Chromium engine when available (selectable text, perfect CSS, native page breaks) and falls back to a fixed canvas pipeline in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Pratik Patel",
  "keywords": [
    "pdf",
    "html-to-pdf",
    "html2pdf",
    "jspdf",
    "puppeteer",
    "playwright",
    "typescript",
    "bun",
    "node",
    "browser",
    "page-break",
    "print"
  ],
  "homepage": "https://github.com/pratik227/htmlpdfx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratik227/htmlpdfx.git"
  },
  "bugs": {
    "url": "https://github.com/pratik227/htmlpdfx/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/index.js": "./dist/browser.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node test/cross-browser.mjs",
    "lint": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build"
  },
  "optionalDependencies": {
    "puppeteer": "^25.1.0"
  },
  "peerDependencies": {
    "playwright": "*",
    "playwright-core": "*",
    "puppeteer-core": "*"
  },
  "peerDependenciesMeta": {
    "puppeteer-core": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "playwright": "^1.60.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitepress": "^1.5.0",
    "vitest": "^2.1.8"
  }
}
