{
  "name": "htmlpdfx",
  "version": "1.0.0",
  "description": "Modern HTML-to-PDF for JavaScript & TypeScript. One unified API across Node, Bun, and the browser. Uses a real Chromium engine when available (selectable text, perfect CSS, native page breaks) and falls back to a fixed canvas pipeline in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Pratik Patel",
  "keywords": [
    "pdf",
    "html-to-pdf",
    "html2pdf",
    "jspdf",
    "puppeteer",
    "playwright",
    "typescript",
    "bun",
    "node",
    "browser",
    "page-break",
    "print"
  ],
  "homepage": "https://github.com/pratik227/htmlpdfx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratik227/htmlpdfx.git"
  },
  "bugs": {
    "url": "https://github.com/pratik227/htmlpdfx/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pratik227"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./global": "./dist/htmlpdfx.global.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/htmlpdfx.global.js",
  "jsdelivr": "./dist/htmlpdfx.global.js",
  "browser": {
    "./dist/index.js": "./dist/browser.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node test/cross-browser.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:browser-download": "node test/browser-download.mjs",
    "lint": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check-links": "node test/check-links.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "docs:agents": "node scripts/gen-llms.mjs",
    "postdocs:build": "npm run docs:agents"
  },
  "optionalDependencies": {
    "puppeteer": "^25.1.0"
  },
  "peerDependencies": {
    "@vue/server-renderer": ">=3",
    "playwright": "*",
    "playwright-core": "*",
    "puppeteer-core": "*",
    "react": ">=17",
    "react-dom": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "puppeteer-core": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@vue/server-renderer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.5",
    "@iconify/utils": "^3.1.4",
    "@types/node": "^22.19.19",
    "pdfjs-dist": "^6.0.227",
    "playwright": "^1.60.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitepress": "^1.5.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0"
  }
}
